+import importlib.util
+from pathlib import Path
+
+import pytest
+
+_MODULE_PATH = Path(__file__).parents[2] / "examples" / "profile" / "summarize_param_offload.py"
+_SPEC = importlib.util.spec_from_file_location("summarize_param_offload", _MODULE_PATH)
+assert _SPEC is not None and _SPEC.loader is not None
+summary = importlib.util.module_from_spec(_SPEC)
+_SPEC.loader.exec_module(summary)
+
+
+def _record(rank, event_id, *, dense_bytes, expert_bytes, dense_group_size=2):
+    return {
+        "event_id": event_id,
+        "action": "offload",
+        "reason": "to_train",
+        "deduplicated": False,
+        "forward_only": False,
+        "model_type": "language_model",
+        "rank": rank,
+        "world_size": 2,
+        "hostname": f"node-{rank}",
+        "dense_group_size": dense_group_size,
+        "expert_group_size": 1,
+        "elapsed_s": 0.1 + rank * 0.1,
+        "process_rss_bytes": 100 + rank * 100,
+        "host_dense_bytes": dense_bytes,
+        "host_expert_bytes": expert_bytes,
+        "host_total_bytes": dense_bytes + expert_bytes,
+    }
+
+
+def test_aggregate_events_sums_host_bytes_and_uses_slowest_rank():
+    event = summary.aggregate_events(
+        [
+            _record(0, 0, dense_bytes=10, expert_bytes=1),
+            _record(1, 0, dense_bytes=20, expert_bytes=2),
+        ]
+    )[0]
+
+    assert event["host_dense_bytes"] == 30
+    assert event["host_expert_bytes"] == 3
+    assert event["host_bytes"] == 33
+    assert event["node_max_host_bytes"] == 22
+    assert event["elapsed_s"] == pytest.approx(0.2)
+
+
+def test_aggregate_events_rejects_incomplete_or_inconsistent_rank_records():
+    with pytest.raises(ValueError, match="incomplete event"):
+        summary.aggregate_events([_record(0, 0, dense_bytes=10, expert_bytes=1)])
+
+    with pytest.raises(ValueError, match="inconsistent dense_group_size"):
+        summary.aggregate_events(
+            [
+                _record(0, 0, dense_bytes=10, expert_bytes=1),
+                _record(1, 0, dense_bytes=20, expert_bytes=2, dense_group_size=4),
+            ]
+        )
+
+
+def test_comparison_requires_matching_event_groups():
+    baseline = {("actor", "offload", "to_train"): {}}
+    with pytest.raises(ValueError, match="profile event groups differ"):
+        summary.print_comparison(baseline, {})
+
+
+def test_summarize_skips_one_shot_groups_during_warmup():
+    records = []
+    for event_id, reason in ((0, "to_manual"), (1, "to_train"), (2, "to_train")):
+        for rank in range(2):
+            record = _record(rank, event_id, dense_bytes=10, expert_bytes=1)
+            record["reason"] = reason
+            records.append(record)
+
+    result = summary.summarize(records, warmup=1)
+
+    assert ("actor", "offload", "to_manual") not in result
+    assert result[("actor", "offload", "to_train")]["samples"] == 1
diff --git a/verl/utils/megatron_utils.py b/verl/utils/megatron_utils.py
index 4947a29b..017fd61f 100644
--- a/verl/utils/megatron_utils.py
+++ b/verl/utils/megatron_utils.py
@@ -193,6 +193,55 @@ def _load_replicated_parameter(
     param._verl_param_offloaded = False
 
 
+def _parameter_nbytes(param: torch.nn.Parameter) -> int:
+    shape = getattr(param, "_verl_offload_shape", param.shape)
+    numel = 1
+    for dim in shape:
+        numel *= dim
+    return numel * param.element_size()
+
+
+def get_megatron_param_offload_snapshot(models) -> dict[str, int]:
+    """Return logical and resident host parameter bytes for local model shards."""
+    logical = {"dense": 0, "expert": 0}
+    host = {"dense": 0, "expert": 0}
+
+    def add_parameter(param):
+        kind = "dense" if getattr(param, "allreduce", True) else "expert"
+        logical[kind] += _parameter_nbytes(param)
+        if param.device.type == "cpu":
+            host[kind] += param.numel() * param.element_size()
+
+    for model_chunk in models:
+        if isinstance(model_chunk, DDP):
+            for kind, buffers in (
+                ("dense", model_chunk.buffers),
+                ("expert", model_chunk.expert_parallel_buffers),
+            ):
+                for buffer in buffers:
+                    param_data = buffer.param_data
+                    storage_size = getattr(buffer, "param_data_size", param_data.storage().size())
+                    logical[kind] += storage_size * param_data.element_size()
+                    cpu_data = getattr(param_data, "cpu_data", None)
+                    if cpu_data is not None:
+                        host[kind] += cpu_data.numel() * cpu_data.element_size()
+            for param in model_chunk.module.parameters():
+                if not param.requires_grad:
+                    add_parameter(param)
+        else:
+            for param in model_chunk.parameters():
+                add_parameter(param)
+
+    return {
+        "logical_dense_bytes": logical["dense"],
+        "logical_expert_bytes": logical["expert"],
+        "logical_total_bytes": logical["dense"] + logical["expert"],
+        "host_dense_bytes": host["dense"],
+        "host_expert_bytes": host["expert"],
+        "host_total_bytes": host["dense"] + host["expert"],
+    }
+
+
 def get_model_config(model):
     return get_attr_wrapped_model(model, "config", allow_none=False)
 
