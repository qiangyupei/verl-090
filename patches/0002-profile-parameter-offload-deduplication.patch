+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import argparse
+import json
+import statistics
+from collections import defaultdict
+from pathlib import Path
+
+PREFIX = "VERL_PARAM_OFFLOAD_PROFILE "
+GIB = 1024**3
+
+
+def load_records(path: Path) -> list[dict]:
+    records = []
+    decoder = json.JSONDecoder()
+    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
+        start = line.find(PREFIX)
+        if start >= 0:
+            record, _ = decoder.raw_decode(line[start + len(PREFIX) :])
+            records.append(record)
+    if not records:
+        raise ValueError(f"no {PREFIX.strip()} records found in {path}")
+    return records
+
+
+def percentile(values: list[float], q: float) -> float:
+    values = sorted(values)
+    if len(values) == 1:
+        return values[0]
+    position = (len(values) - 1) * q
+    lower = int(position)
+    upper = min(lower + 1, len(values) - 1)
+    weight = position - lower
+    return values[lower] * (1 - weight) + values[upper] * weight
+
+
+def role(record: dict) -> str:
+    if record["forward_only"]:
+        return "ref"
+    return "critic" if record.get("model_type") == "value_model" else "actor"
+
+
+def validate_records(records: list[dict], *, deduplicated: bool) -> None:
+    modes = {record["deduplicated"] for record in records}
+    if modes != {deduplicated}:
+        raise ValueError(f"expected deduplicated={deduplicated}, found {sorted(modes)}")
+
+
+def aggregate_events(records: list[dict]) -> list[dict]:
+    grouped = defaultdict(list)
+    for record in records:
+        key = (role(record), record["action"], record["reason"], record["event_id"])
+        grouped[key].append(record)
+
+    events = []
+    for (model_role, action, reason, event_id), rows in grouped.items():
+        for field in ("world_size", "dense_group_size", "expert_group_size"):
+            values = {row[field] for row in rows}
+            if len(values) != 1:
+                raise ValueError(f"inconsistent {field} for {model_role}/{action}/{reason}/{event_id}: {values}")
+        ranks = {row["rank"] for row in rows}
+        expected_ranks = rows[0]["world_size"]
+        if len(rows) != expected_ranks or ranks != set(range(expected_ranks)):
+            raise ValueError(
+                f"incomplete event {model_role}/{action}/{reason}/{event_id}: "
+                f"found ranks {sorted(ranks)}, expected 0..{expected_ranks - 1} exactly once"
+            )
+        by_host = defaultdict(list)
+        for row in rows:
+            by_host[row["hostname"]].append(row)
+        node_host_bytes = [sum(row["host_total_bytes"] for row in node_rows) for node_rows in by_host.values()]
+        node_rss_bytes = [sum(row["process_rss_bytes"] for row in node_rows) for node_rows in by_host.values()]
+        elapsed = [row["elapsed_s"] for row in rows if row["elapsed_s"] is not None]
+        events.append(
+            {
+                "role": model_role,
+                "action": action,
+                "reason": reason,
+                "event_id": event_id,
+                "dense_group_size": rows[0]["dense_group_size"],
+                "expert_group_size": rows[0]["expert_group_size"],
+                "host_dense_bytes": sum(row["host_dense_bytes"] for row in rows),
+                "host_expert_bytes": sum(row["host_expert_bytes"] for row in rows),
+                "host_bytes": sum(node_host_bytes),
+                "node_max_host_bytes": max(node_host_bytes),
+                "rss_bytes": sum(node_rss_bytes),
+                "node_max_rss_bytes": max(node_rss_bytes),
+                "elapsed_s": max(elapsed) if elapsed else None,
+            }
+        )
+    return events
+
+
+def summarize(records: list[dict], warmup: int) -> dict[tuple[str, str, str], dict]:
+    grouped = defaultdict(list)
+    for event in aggregate_events(records):
+        grouped[(event["role"], event["action"], event["reason"])].append(event)
+
+    summary = {}
+    for key, events in grouped.items():
+        events.sort(key=lambda event: event["event_id"])
+        if len(events) <= warmup:
+            continue
+        measured = events[warmup:]
+        elapsed = [event["elapsed_s"] for event in measured if event["elapsed_s"] is not None]
+        summary[key] = {
+            "samples": len(measured),
+            "dense_group_size": max(event["dense_group_size"] for event in measured),
+            "expert_group_size": max(event["expert_group_size"] for event in measured),
+            "host_dense_gib": statistics.median(event["host_dense_bytes"] for event in measured) / GIB,
+            "host_expert_gib": statistics.median(event["host_expert_bytes"] for event in measured) / GIB,
+            "host_gib": statistics.median(event["host_bytes"] for event in measured) / GIB,
+            "node_max_host_gib": statistics.median(event["node_max_host_bytes"] for event in measured) / GIB,
+            "rss_gib": statistics.median(event["rss_bytes"] for event in measured) / GIB,
+            "node_max_rss_gib": statistics.median(event["node_max_rss_bytes"] for event in measured) / GIB,
+            "latency_p50_s": percentile(elapsed, 0.5) if elapsed else None,
+            "latency_p95_s": percentile(elapsed, 0.95) if elapsed else None,
+        }
+    if not summary:
+        raise ValueError(f"no event group has more than {warmup} warmup samples")
+    return summary
+
+
+def print_summary(name: str, summary: dict) -> None:
+    print(f"\n{name}")
+    print(
+        "role\taction\treason\tn\tdense_group\texpert_group\tdense_host_GiB\texpert_host_GiB\t"
+        "host_GiB\tnode_max_host_GiB\trss_GiB\tnode_max_rss_GiB\tlatency_p50_s\tlatency_p95_s"
+    )
+    for key, row in sorted(summary.items()):
+        latency_p50 = "-" if row["latency_p50_s"] is None else f"{row['latency_p50_s']:.4f}"
+        latency_p95 = "-" if row["latency_p95_s"] is None else f"{row['latency_p95_s']:.4f}"
+        print(
+            f"{key[0]}\t{key[1]}\t{key[2]}\t{row['samples']}\t{row['dense_group_size']}\t"
+            f"{row['expert_group_size']}\t{row['host_dense_gib']:.2f}\t{row['host_expert_gib']:.2f}\t"
+            f"{row['host_gib']:.2f}\t"
+            f"{row['node_max_host_gib']:.2f}\t{row['rss_gib']:.2f}\t{row['node_max_rss_gib']:.2f}\t"
+            f"{latency_p50}\t{latency_p95}"
+        )
+
+
+def print_comparison(baseline: dict, dedup: dict) -> None:
+    if baseline.keys() != dedup.keys():
+        missing_from_dedup = sorted(baseline.keys() - dedup.keys())
+        missing_from_baseline = sorted(dedup.keys() - baseline.keys())
+        raise ValueError(
+            f"profile event groups differ: missing from dedup={missing_from_dedup}, "
+            f"missing from baseline={missing_from_baseline}"
+        )
+    print("\nbaseline -> dedup")
+    print(
+        "role\taction\treason\tdense_saved_GiB\texpert_saved_GiB\thost_saved_GiB\t"
+        "host_saved_pct\tlatency_p50_overhead_pct"
+    )
+    for key in sorted(baseline):
+        before = baseline[key]
+        after = dedup[key]
+        saved = before["host_gib"] - after["host_gib"]
+        saved_pct = 100 * saved / before["host_gib"] if before["host_gib"] else 0.0
+        if before["latency_p50_s"] and after["latency_p50_s"] is not None:
+            overhead = 100 * (after["latency_p50_s"] / before["latency_p50_s"] - 1)
+            overhead_text = f"{overhead:.2f}"
+        else:
+            overhead_text = "-"
+        dense_saved = before["host_dense_gib"] - after["host_dense_gib"]
+        expert_saved = before["host_expert_gib"] - after["host_expert_gib"]
+        print(
+            f"{key[0]}\t{key[1]}\t{key[2]}\t{dense_saved:.2f}\t{expert_saved:.2f}\t"
+            f"{saved:.2f}\t{saved_pct:.2f}\t{overhead_text}"
+        )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Summarize Megatron parameter-offload profile logs.")
+    parser.add_argument("--baseline", type=Path, required=True)
+    parser.add_argument("--dedup", type=Path, required=True)
+    parser.add_argument("--warmup", type=int, default=2)
+    args = parser.parse_args()
+
+    baseline_records = load_records(args.baseline)
+    dedup_records = load_records(args.dedup)
+    validate_records(baseline_records, deduplicated=False)
+    validate_records(dedup_records, deduplicated=True)
+    baseline_summary = summarize(baseline_records, args.warmup)
+    dedup_summary = summarize(dedup_records, args.warmup)
+    print_summary("baseline", baseline_summary)
+    print_summary("dedup", dedup_summary)
+    print_comparison(baseline_summary, dedup_summary)
+
+
+if __name__ == "__main__":
+    main()
