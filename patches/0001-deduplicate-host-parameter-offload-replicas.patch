+def test_param_offload_group_builder_uses_dense_and_expert_replica_groups(monkeypatch):
+    dense_process_group = object()
+    expert_process_group = object()
+    dense_group_args = []
+    expert_group_args = []
+    monkeypatch.setattr(
+        megatron_utils.mpu,
+        "get_data_parallel_group",
+        lambda with_context_parallel, with_gtp_remat=True: (
+            dense_group_args.append((with_context_parallel, with_gtp_remat)) or dense_process_group
+        ),
+    )
+    monkeypatch.setattr(
+        megatron_utils.mpu,
+        "get_expert_data_parallel_group",
+        lambda with_gtp_remat=True: expert_group_args.append(with_gtp_remat) or expert_process_group,
